# Runtime logs (generated by qdm-mt5-autosync.ps1)
logs/
*.log
*.log.err

# qdmcli command scratch file (regenerated each run)
qdm_commands.txt

# Run lock (prevents overlapping syncs; removed on clean exit)
run.lock

# Personal config - never commit your real paths/symbol lists
config.json

# Internal docs / handoff specs - not part of the public repo
docs/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Compiled MQL5 artifacts (rebuild from source)
*.ex5
